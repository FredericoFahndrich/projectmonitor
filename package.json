{
  "name": "project-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "dev:api": "npm run dev -w backend",
    "build": "npm run build -w frontend",
    "typecheck": "npm run typecheck -w backend",
    "test": "tsx --test backend/tests/*.test.ts frontend/tests/*.test.js",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write frontend/src backend/src backend/tests frontend/tests shared docs *.json README.md"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "miniflare": "^4.0.0",
    "prettier": "^3.0.0",
    "@playwright/test": "^1.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "undici": "^7.30.1",
    "sharp": "^0.35.5"
  }
}
